# ==========================================
# 站点与联盟配置
# ==========================================
# 生产环境必须设为正式域名（影响 canonical / sitemap / OG）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Amazon Associates Tracking ID
NEXT_PUBLIC_AMAZON_AFFILIATE_TAG=jyu0a-20

# ==========================================
# 安全（必填）
# ==========================================
# 后台管理密码，至少 6 字符。不设置则后台完全不可登录。
# 生成方式：openssl rand -base64 24
ADMIN_SECRET_KEY=

# ==========================================
# Google Ads 转化跟踪（按钮点击微转化）
# ==========================================
NEXT_PUBLIC_GA_CONVERSION_ID=
NEXT_PUBLIC_GA_CONVERSION_LABEL=

# ==========================================
# PostHog 行为分析（可选）
# ==========================================
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ==========================================
# AI 内容生成（原生 TS 引擎使用，可选）
# ==========================================
# 自动选择顺序: custom → anthropic → openai → 模板兜底
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=deepseek-chat
CUSTOM_AI_PROTOCOL=openai
AI_MODEL_CHOICE=auto

# ==========================================
# SEO / 收录 / 分发（可选）
# ==========================================
BING_API_KEY=
SOCIAL_WEBHOOK_URL=
AYRSHARE_API_KEY=

# ==========================================
# SERP 真盘数据（可选 — 未配置时用启发式基准）
# serpapi.com 免费 100 次/月
# ==========================================
SERPAPI_KEY=

# ==========================================
# Amazon Product Advertising API（可选 — 价格追踪 + 官方商品图）
# Amazon Associates 后台申请。需满足 3 个月内 3 笔销售才可获批（新站先跑基线模式）。
# ==========================================
PA_ACCESS_KEY=
PA_SECRET_KEY=
PA_PARTNER_TAG=
PA_HOST=webservices.amazon.com
PA_REGION=us-east-1

# ==========================================
# 邮件服务（可选 — lead magnet 真实发信 + 降价提醒）
# resend.com 免费 3000 封/月；域名需先验证
# ==========================================
RESEND_API_KEY=
LEADS_FROM_EMAIL=deals@yourdomain.com
